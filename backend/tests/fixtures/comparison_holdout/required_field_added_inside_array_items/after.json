{
  "openapi": "3.0.3",
  "info": {
    "title": "Acme",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://api.acme.com/v1"
    }
  ],
  "paths": {
    "/o": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sku": {
                          "type": "string"
                        },
                        "qty": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "sku",
                        "qty"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
