{
  "openapi": "3.0.3",
  "info": {
    "title": "Acme Pets",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.acme.com/v1"
    }
  ],
  "paths": {
    "/pets": {
      "get": {
        "summary": "List pets",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      },
      "post": {
