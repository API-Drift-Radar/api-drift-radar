        "responses": {
          "201": {
            "description": "created"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "name": "Fido"
              }
            }
          }
        }
      }
    }
  }
}
