      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "schema": {
            "type": "integer"
          }
        }
      ],
      "servers": [
        {
          "url": "https://eu.acme.com"
        }
      ],
      "x-internal": true
    },
    "/pets/{id}": {
      "get": {
        "summary": "Get a pet",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      },
      "delete": {
