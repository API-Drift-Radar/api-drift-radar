{
  "openapi": "3.0.3",
  "info": {
    "title": "Acme Pets",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.acme.com/v1"
    }
  ],
  "paths": {
    "/pets": {
      "get": {
        "summary": "List pets",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      },
      "post": {
        "summary": "Create a pet",
        "responses": {
          "201": {
            "description": "created"
          }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "summary": "Get a pet",
        "responses": {
          "200": {
            "description": "ok"
          }
        },
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "expand",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ]
      },
      "delete": {
        "summary": "Delete a pet",
        "responses": {
          "204": {
            "description": "gone"
          }
        }
      }
    }
  }
}
