{
  "openapi": "3.0.3",
  "info": {
    "title": "Acme Pets",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.acme.com/v1"
    }
  ],
  "paths": {
    "/pets": {
      "get": {
        "summary": "List pets",
        "responses": {
          "200": {
            "description": "ok"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          }
        ]
      },
      "post": {
        "summary": "Create a pet",
        "responses": {
          "201": {
            "description": "created"
          }
        }
      }
    },
    "/pets/{id}": {
      "get": {
        "summary": "Get a pet",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      },
      "delete": {
        "summary": "Delete a pet",
        "responses": {
          "204": {
            "description": "gone"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer"
        }
      }
    }
  }
}
