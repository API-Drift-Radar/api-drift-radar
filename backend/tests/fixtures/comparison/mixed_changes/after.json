{
  "openapi": "3.0.3",
  "info": {
    "title": "Acme Pets",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.acme.com/v2"
    }
  ],
  "paths": {
    "/pets": {
      "get": {
        "summary": "List all pets",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      },
      "post": {
        "summary": "Create a pet",
        "responses": {
          "201": {
            "description": "created"
          }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "summary": "Get a pet",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/owners": {
      "get": {
        "summary": "List owners",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  }
}
