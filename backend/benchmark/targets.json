{
 "schema_version": 1,
 "labels_by": "the maintainer's own reading of each provider's published material; not independently audited",
 "targets": [
  {
   "target": "https://api.stripe.com",
   "expect": "found",
   "accept": [
    "stripe/openapi"
   ],
   "reject": [],
   "note": "provider mapping"
  },
  {
   "target": "https://api.github.com",
   "expect": "found",
   "accept": [
    "rest-api-description"
   ],
   "reject": [],
   "note": "one entry per dated version: ambiguous is correct"
  },
  {
   "target": "https://petstore3.swagger.io",
   "expect": "found",
   "accept": [
    "petstore3.swagger.io/api/v3/openapi.json"
   ],
   "reject": [],
   "note": "path named only in the viewer script"
  },
  {
   "target": "https://petstore31.swagger.io",
   "expect": "found",
   "accept": [
    "petstore31.swagger.io/api/v31/openapi.json"
   ],
   "reject": [],
   "note": "same, OpenAPI 3.1"
  },
  {
   "target": "https://api.weather.gov",
   "expect": "found",
   "accept": [
    "api.weather.gov/openapi.json"
   ],
   "reject": [],
   "note": "common location"
  },
  {
   "target": "https://dev.to",
   "expect": "found",
   "accept": [
    "dev.to/api/v1/openapi.json"
   ],
   "reject": [],
   "note": "common location under a path"
  },
  {
   "target": "https://fakerestapi.azurewebsites.net",
   "expect": "found",
   "accept": [
    "swagger/v1/swagger.json"
   ],
   "reject": [],
   "note": "framework probe"
  },
  {
   "target": "https://api.apis.guru",
   "expect": "found",
   "accept": [
    "apis.guru"
   ],
   "reject": [],
