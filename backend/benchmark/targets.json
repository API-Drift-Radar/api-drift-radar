  },
  {
   "target": "https://api.twilio.com",
   "expect": "found",
   "accept": [
    "twilio-oai"
   ],
   "reject": [],
   "note": "directory, provider source"
  },
  {
   "target": "https://api.openai.com",
   "expect": "found",
   "accept": [
    "openai-openapi"
   ],
   "reject": [],
   "note": "directory, provider source"
  },
  {
   "target": "https://api.sendgrid.com",
   "expect": "found",
   "accept": [
    "sendgrid"
   ],
   "reject": [],
   "note": "directory; the provider source has moved, so the directory copy is used"
  },
  {
   "target": "https://api.vercel.com",
   "expect": "found",
   "accept": [
    "openapi.vercel.sh/"
   ],
   "reject": [
    "marketplace-openapi"
   ],
   "note": "the full contract, not the marketplace subset"
  },
  {
   "target": "https://api.box.com",
   "expect": "found",
   "accept": [
    "box.com"
   ],
   "reject": [],
   "note": "directory copy"
  },
  {
   "target": "https://api.digitalocean.com",
   "expect": "found",
   "accept": [
    "digitalocean",
    "apis.guru/v2/specs/digitalocean.com"
   ],
   "reject": [],
   "note": "source references hundreds of files; the single-file copy fits"
  },
  {
   "target": "https://api.spotify.com",
   "expect": "found",
   "accept": [
    "developer.spotify.com/reference/web-api/open-api-schema.yaml",
    "apis.guru/v2/specs/spotify.com/"
   ],
   "reject": [
    "sonallux"
   ],
   "note": "the official contract (or the directory copy of it); a third-party fork is wrong"
  },
  {
   "target": "https://api.slack.com",
   "expect": "found",
   "accept": [
    "slack-api-specs",
    "apis.guru/v2/specs/slack.com"
   ],
   "reject": [
    "ai-plugin"
   ],
   "note": "the Web API contract, not the AI plugin manifest"
  },
  {
   "target": "https://httpbin.org",
   "expect": "found",
   "accept": [
    "httpbin"
   ],
   "reject": [],
   "note": "the origin publishes Swagger 2 only; the directory copy is OpenAPI 3"
  },
  {
   "target": "https://api.nasa.gov",
   "expect": "found",
   "accept": [
    "nasa.gov"
   ],
   "reject": [],
