# Optional runtime data location for future monitoring components.
# Export these variables in your shell; .env files are not loaded automatically.
# Copy this file to .env (git ignores it), fill in the values yourself, then load it with:
#   set -a; source .env; set +a
RADAR_DATA_DIR=.radar

# Optional language-model fallback for discovery (Merge Gateway). Leave unset to keep it off.
# Never commit a real key and never paste one into chat, issues or logs.
MERGE_API_KEY=
# Optional: provider/model to use. The default is a small, inexpensive model.
# MERGE_MODEL=anthropic/claude-haiku-4-5
